NEXT_PUBLIC_ROOT_DOMAIN=barrechner.ch
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Local/manual setup names. Vercel's prefixed integration variables and server-side fallbacks are also supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Prefer a new sb_secret_ key. The legacy SUPABASE_SERVICE_ROLE_KEY remains supported.
SUPABASE_SECRET_KEY=your-secret-key
CRON_SECRET=replace-with-a-long-random-value
MISTRAL_API_KEY=replace-with-your-mistral-api-key
